            { "id": "wc_4", "label": "4", "value": 4 },
            { "id": "wc_5", "label": "5", "value": 5 }
          ]
        },
        {
          "id": "wso",
          "question": "How much does the social scene matter — the friends you'll make, the clubs, the nights out, the culture outside class?",
          "type": "likert",
          "scale": 5,
          "leftLabel": "Not a priority",
          "rightLabel": "Everything",
          "defaultValue": 3,
          "options": [
            { "id": "wso_1", "label": "1", "value": 1 },
            { "id": "wso_2", "label": "2", "value": 2 },
            { "id": "wso_3", "label": "3", "value": 3 },
            { "id": "wso_4", "label": "4", "value": 4 },
            { "id": "wso_5", "label": "5", "value": 5 }
          ]
        }
      ]
    },
    {
      "id": "academics",
      "title": "Academics",
      "description": "Tell us what you're actually drawn to — not what sounds impressive.",
      "questions": [
        {
          "id": "AA",
          "question": "Which of these areas genuinely excite you? Pick up to 3 — the ones you'd read about even if it wasn't for school.",
          "type": "checkbox",
          "maxSelections": 3,
          "options": [
            { "id": "aa_engineering", "label": "Engineering (mechanical, civil, electrical, aerospace...)", "value": "engineering" },
            { "id": "aa_cs_math", "label": "Computer science, software & math", "value": "cs-math" },
            { "id": "aa_business", "label": "Business, economics & finance", "value": "business" },
            { "id": "aa_health", "label": "Health & life sciences (pre-med, biology, kinesiology...)", "value": "health" },
            { "id": "aa_sciences", "label": "Physical & environmental sciences (physics, chemistry, earth science...)", "value": "sciences" },
            { "id": "aa_social", "label": "Social sciences & psychology", "value": "social-sciences" },
            { "id": "aa_arts", "label": "Arts, design & media", "value": "arts-humanities" },
            { "id": "aa_education", "label": "Education, law & public policy", "value": "education-law" },
            { "id": "aa_undecided", "label": "I genuinely have no idea yet", "value": "undecided" }
          ]
        },
        {
          "id": "LC",
          "question": "Which high school subjects did you actually enjoy? Pick all that apply.",
          "type": "checkbox",
          "maxSelections": 6,
          "options": [
            { "id": "lc_math", "label": "Math / calculus", "value": "Mathematics" },
            { "id": "lc_physics", "label": "Physics", "value": "Physics" },
            { "id": "lc_cs", "label": "Computer science", "value": "Computer Science" },
            { "id": "lc_chemistry", "label": "Chemistry", "value": "Chemistry" },
            { "id": "lc_biology", "label": "Biology", "value": "Biology" },
            { "id": "lc_english", "label": "English / literature", "value": "English" },
            { "id": "lc_history", "label": "History", "value": "History" },
            { "id": "lc_social", "label": "Social studies / civics", "value": "Social Studies" },
            { "id": "lc_econ", "label": "Economics / business", "value": "Economics" },
            { "id": "lc_art", "label": "Art / visual arts", "value": "Art" },
            { "id": "lc_psych", "label": "Psychology / sociology", "value": "Psychology" },
            { "id": "lc_geo", "label": "Geography / earth science", "value": "Geography" }
          ]
        },
        {
          "id": "ME",
          "question": "Be honest: how much do you actually enjoy math — not how good you are at it, but whether you find it satisfying?",
          "type": "likert",
          "scale": 5,
          "leftLabel": "I avoid it",
          "rightLabel": "I genuinely love it",
          "defaultValue": 3,
          "options": [
            { "id": "me_1", "label": "1", "value": 1 },
            { "id": "me_2", "label": "2", "value": 2 },
            { "id": "me_3", "label": "3", "value": 3 },
            { "id": "me_4", "label": "4", "value": 4 },
            { "id": "me_5", "label": "5", "value": 5 }
          ]
        },
        {
          "id": "CR",
          "question": "When you imagine your best school project, which feels most like you?",
          "type": "radio",
          "options": [
            { "id": "cr_2", "label": "Building or making something tangible with my hands or tools", "value": "2" },
            { "id": "cr_3", "label": "Solving a well-defined problem that has a right answer", "value": "3" },
            { "id": "cr_4", "label": "Something that mixes creative thinking with logical structure", "value": "4" },
            { "id": "cr_5", "label": "Designing, expressing, or inventing something original", "value": "5" }
          ]
        },
        {
          "id": "CO",
          "question": "Co-op means alternating school semesters with paid work terms — your degree takes longer but you graduate with real experience and often a job offer. How important is this?",
          "type": "likert",
          "scale": 5,
          "leftLabel": "I'd rather finish faster",
          "rightLabel": "This is a must-have",
          "defaultValue": 3,
          "options": [
            { "id": "co_1", "label": "1", "value": 1 },
            { "id": "co_2", "label": "2", "value": 2 },
            { "id": "co_3", "label": "3", "value": 3 },
            { "id": "co_4", "label": "4", "value": 4 },
            { "id": "co_5", "label": "5", "value": 5 }
          ]
        },
        {
          "id": "UR",
          "question": "How interested are you in doing academic research — working with professors on studies, experiments, or original work published in journals?",
          "type": "likert",
          "scale": 5,
          "leftLabel": "Not for me",
          "rightLabel": "I'd love this",
          "defaultValue": 3,
          "options": [
            { "id": "ur_1", "label": "1", "value": 1 },
            { "id": "ur_2", "label": "2", "value": 2 },
            { "id": "ur_3", "label": "3", "value": 3 },
            { "id": "ur_4", "label": "4", "value": 4 },
            { "id": "ur_5", "label": "5", "value": 5 }
          ]
        },
        {
          "id": "CE",
          "question": "How clear are you on what career or field you want to go into?",
          "type": "radio",
          "options": [
            { "id": "ce_2", "label": "No idea — I want to explore broadly before committing", "value": "2" },
            { "id": "ce_3", "label": "A general direction, but it could easily change", "value": "3" },
            { "id": "ce_4", "label": "A specific field — I want a program that points me there", "value": "4" },
            { "id": "ce_5", "label": "I know exactly what I want to do", "value": "5" }
          ]
        }
      ]
    },
    {
      "id": "campus",
      "title": "Campus & location",
      "description": "You'll be here for four years. This matters more than people admit when they're choosing.",
      "questions": [
        {
          "id": "SET",
          "question": "What kind of environment do you want around you every day?",
          "type": "radio",
          "options": [
            { "id": "set_urban", "label": "A real city — transit, nightlife, internships nearby, things always happening", "value": "Urban" },
            { "id": "set_suburban", "label": "Close to a city but calmer — a town with decent amenities", "value": "Suburban" },
            { "id": "set_smalltown", "label": "A small university town where campus IS the social scene", "value": "Small-town" }
          ]
        },
        {
          "id": "CPS",
          "question": "How big do you want the university itself to be?",
          "type": "radio",
          "options": [
            { "id": "cps_small", "label": "Small — professors know your name, tight-knit community", "value": "Small" },
            { "id": "cps_medium", "label": "Medium — enough variety without being overwhelming", "value": "Medium" },
            { "id": "cps_large", "label": "Large — big reputation, lots of resources, tons of people", "value": "Large" }
          ]
        },
        {
          "id": "CSB",
          "question": "What class size will you actually learn best in?",
          "type": "radio",
          "options": [
            { "id": "csb_small", "label": "Small (under 60) — I want to know my classmates and actually talk in class", "value": "< 60" },
            { "id": "csb_medium", "label": "Mid-size (60–200) — a mix of lectures and smaller tutorial groups", "value": "60-200" },
            { "id": "csb_large", "label": "Large (200+) — I'm fine in a big lecture hall, I work independently", "value": "200+" }
          ]
        },
        {
          "id": "HS",
          "question": "What first-year housing setup sounds most like you? Pick all that appeal.",
          "type": "checkbox",
          "maxSelections": 4,
          "options": [
            { "id": "hs_trad", "label": "Traditional dorm — shared floor, communal bathrooms, classic res life", "value": "Traditional dorm" },
            { "id": "hs_suite", "label": "Suite-style — small group shares a bathroom and common room", "value": "Suite-style" },
            { "id": "hs_apt", "label": "Apartment-style — more independent, own kitchen", "value": "Apartment" },
            { "id": "hs_off", "label": "Off-campus right away — I'd rather find my own place", "value": "Off-campus" }
          ]
        }
      ]
    },
    {
      "id": "social",
      "title": "Social life & extracurriculars",
      "description": "Honest answers here help us match you with a campus where you'll actually fit.",
      "questions": [
        {
          "id": "NS",
          "question": "What kind of social scene do you want outside of class?",
          "type": "likert",
          "scale": 5,
          "leftLabel": "Quiet — study, sleep, small group of close friends",
          "rightLabel": "Lively — real nightlife and constant social energy",
          "defaultValue": 3,
          "options": [
            { "id": "ns_1", "label": "1", "value": 1 },
            { "id": "ns_2", "label": "2", "value": 2 },
            { "id": "ns_3", "label": "3", "value": 3 },
            { "id": "ns_4", "label": "4", "value": 4 },
            { "id": "ns_5", "label": "5", "value": 5 }
          ]
        },
        {
          "id": "CLB",
          "question": "Which extracurricular scenes sound like your people? Pick all that apply.",
          "type": "checkbox",
          "maxSelections": 5,
          "options": [
            { "id": "clb_hack", "label": "Hackathons & tech competitions", "value": "Hackathons" },
            { "id": "clb_entre", "label": "Entrepreneurship & startup culture", "value": "Entrepreneurship" },
            { "id": "clb_design", "label": "Engineering design teams & build competitions", "value": "Design teams" },
            { "id": "clb_case", "label": "Case competitions & business clubs", "value": "Case comps" },
            { "id": "clb_volunteer", "label": "Volunteering & community service", "value": "Volunteering" },
            { "id": "clb_arts", "label": "Performing arts — theatre, music, dance", "value": "Performing arts" },
            { "id": "clb_env", "label": "Environmental & sustainability clubs", "value": "Environmental" },
            { "id": "clb_greek", "label": "Greek life — fraternities or sororities", "value": "Greek life" },
            { "id": "clb_cultural", "label": "Cultural student associations", "value": "Cultural" },
            { "id": "clb_none", "label": "I'm not really a clubs person", "value": "None" }
          ]
        },
        {
          "id": "SPT",
          "question": "Do varsity or intramural sports matter to you at university?",
          "type": "radio",
          "options": [
            { "id": "spt_none", "label": "Not really — sports culture isn't something I care about", "value": "none" },
            { "id": "spt_rec", "label": "Intramurals for fun, yes — not varsity-level intensity", "value": "rec" },
            { "id": "spt_varsity", "label": "I want a school with strong varsity sports energy", "value": "varsity" }
          ]
        },
        {
          "id": "CEV",
          "question": "How much do cultural events on campus matter to you — concerts, festivals, guest speakers, art shows?",
          "type": "likert",
          "scale": 5,
          "leftLabel": "Doesn't matter",
          "rightLabel": "A big part of why I'd choose a school",
          "defaultValue": 3,
          "options": [
            { "id": "cev_1", "label": "1", "value": 1 },
            { "id": "cev_2", "label": "2", "value": 2 },
            { "id": "cev_3", "label": "3", "value": 3 },
            { "id": "cev_4", "label": "4", "value": 4 },
            { "id": "cev_5", "label": "5", "value": 5 }
          ]
        }
      ]
    }
  ]
