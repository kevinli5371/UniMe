{
  "title": "UniMe University Program Quiz",
  "sections": [
    {
      "id": "weights",
      "title": "What matters most to you?",
      "description": "These three sliders set how we weigh your results. Most students care about all three — be honest about what you'd actually sacrifice.",
      "questions": [
        {
          "id": "wa",
          "question": "How much does the academic program itself matter — the courses, professors, research, and career outcomes?",
          "type": "likert",
          "scale": 5,
          "leftLabel": "Not a priority",
          "rightLabel": "Everything",
          "defaultValue": 3,
          "options": [
            { "id": "wa_1", "label": "1", "value": 1 },
            { "id": "wa_2", "label": "2", "value": 2 },
            { "id": "wa_3", "label": "3", "value": 3 },
            { "id": "wa_4", "label": "4", "value": 4 },
            { "id": "wa_5", "label": "5", "value": 5 }
          ]
        },
        {
          "id": "wc",
          "question": "How much does the campus itself matter — the city, the size, the vibe, the buildings you'll walk through every day?",
          "type": "likert",
          "scale": 5,
          "leftLabel": "Not a priority",
          "rightLabel": "Everything",
          "defaultValue": 3,
          "options": [
            { "id": "wc_1", "label": "1", "value": 1 },
            { "id": "wc_2", "label": "2", "value": 2 },
